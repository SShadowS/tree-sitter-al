# Analysis and utility scripts
*.py
# But allow keyword-sync tools
!tools/keyword-sync/*.py
!tools/keyword-sync/output/
tools/keyword-sync/__pycache__/
# Everything directly under tools/ is a checked-in helper, not scratch. These are
# wired into validate-grammar.sh (orphan, duplicate, health and field-shape
# checks); if they are not tracked, a fresh clone silently skips those steps.
!tools/*.py
# Written to the repo root by every text-format run of
# tools/find_unused_definitions.py — a report, not a source artifact
grammar_analysis.json
current_orphans.txt
orphan_report.txt
run_query*.sh
# Ignore queries/ except standard tree-sitter query files
queries/*
!queries/tags.scm
!queries/highlights.scm
!queries/locals.scm
!queries/indents.scm
!queries/folds.scm
!queries/textobjects.scm
FIXES.md

# AI assistant files
.claude/
.clinerules/
.goosehints
CLAUDE.md
settings.local.json

# Development and analysis files
*PLAN*.md
*SUMMARY*.md
*MIGRATION*.md
*MERGE*.md
*SOLUTION*.md
*CONVENTION*.md
*MISSING*.md
*QUERIES*.md
*RULES*.md
*GUIDE*.md
