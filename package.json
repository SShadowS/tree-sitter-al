{
  "name": "@sshadows/tree-sitter-al",
  "version": "4.4.1",
  "description": "AL for Business Central",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SShadowS/tree-sitter-al.git"
  },
  "license": "MIT",
  "author": {
    "name": "Torben Leth",
    "email": "sshadows@sshadows.dk"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "default": "./bindings/node/index.js"
    },
    "./bindings/node": {
      "types": "./bindings/node/index.d.ts",
      "default": "./bindings/node/index.js"
    },
    "./traversal": {
      "types": "./traversal/index.d.ts",
      "default": "./traversal/index.js"
    },
    "./*": "./*"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "al"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*.scm",
    "src/**",
    "traversal/*.js",
    "traversal/*.d.ts",
    "traversal/*.json",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.7.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.7",
    "web-tree-sitter": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test tests/traversal/js/parity.test.js tests/traversal/js/canaries.test.js tests/traversal/js/esm.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "tree-sitter": [
    {
      "scope": "source.al",
      "injection-regex": "^al$"
    }
  ]
}
